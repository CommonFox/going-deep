# Copy this file to .env and fill in your own values. .env is gitignored.

# Required for src/silver/espn.py to access a private ESPN fantasy league.
# Pull these from the cookies of a logged-in browser session at fantasy.espn.com
# (devtools > Application > Cookies). SWID includes the surrounding curly braces.
ESPN_S2=
SWID=

# Required for scripts/publish_export.py to upload data/export/ to the private Vercel Blob store
# the deployed SPA reads from (#130). From the Vercel dashboard: the project's Storage tab > your
# Blob store > .env.local tab > copy the BLOB_READ_WRITE_TOKEN value.
BLOB_READ_WRITE_TOKEN=
